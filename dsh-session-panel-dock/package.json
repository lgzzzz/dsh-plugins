{
  "name": "dsh-session-panel-dock",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "description": "会话面板始终以停靠形态出现:恒开主对话的停靠探针,并在面板显示时把正文宽度上限设为 min(自然宽度, max(480px, 列宽 − 400px)),让面板占一列而不是压在正文上;宽外框不改正文宽度,空间不足时仍保持停靠形态。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "check": "node --check lib/client.js && node --check index.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
