{
  "name": "dsh-header-action-order",
  "version": "1.0.0",
  "private": true,
  "description": "按固定顺序重排会话标题栏的动作图标(conversation.session.header.actions 列表槽位):就地改写各注册项的 options.order,并在槽位注册变化时重排。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.mjs",
    "check": "node --check lib/client.js && node --check index.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
