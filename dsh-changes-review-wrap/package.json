{
  "name": "dsh-changes-review-wrap",
  "version": "1.0.0",
  "private": true,
  "description": "让右栏的改动审查（changes-review）标签页默认开启自动换行：每个新审查标签页首次挂载时，经换行按钮自己的 React onClick 把上游客服的 wrap 置为 true（不合成点击事件、不抢焦点），工具栏的换行按钮保持可开关；同一标签页切走再切回不会改写用户的选择，关闭重开则重新按默认开启。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "check": "node --check lib/client.js && node --check index.ts",
    "test": "node test/run-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.2",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3"
  }
}
