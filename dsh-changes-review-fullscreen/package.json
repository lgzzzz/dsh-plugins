{
  "name": "dsh-changes-review-fullscreen",
  "version": "1.0.0",
  "private": true,
  "description": "右栏改动审查（changes-review）标签页的默认 diff 布局：非全屏（push）默认单栏，全屏（fullscreen，含窄窗口自动全屏）默认左右对比；标签页首次挂载与面板呈现方式切换时按面板现值写入 review store 的 split，打开标签页时不再自动切全屏。工具栏的分栏按钮照常可开关，同一呈现方式内不会再次改写用户的选择。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "check": "node --check lib/client.js && node --check index.ts",
    "test": "node test/run-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.2-rc.2",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
