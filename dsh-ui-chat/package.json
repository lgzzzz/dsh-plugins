{
  "name": "dsh-client-ui-chat-lgz",
  "description": "This is a fork of @deepseek-ai/dsh-client-ui-chat in deepseek harness. Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-workspace-files": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-brand": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-product-analytics": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-approval": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-commands": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-compaction": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm-retry": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-stats": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-turn-outline": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-subagent": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-values": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.4",
    "@tanstack/react-virtual": "3.14.10",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^30.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5-alpha.2"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js"
  ]
}
