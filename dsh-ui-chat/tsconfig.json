{
  // 本仓库(独立插件仓库)没有上游 monorepo 的 tsconfig.base.json /
  // tsconfig.base.client.json 与那几十条 project references，所以这里是一份自足配置：
  // 只告诉类型检查器与编辑器它需要的事——走自动 JSX 运行时、按打包器规则解析模块。
  // tsdown 直接从 src/ 打 lib/，不经过 tsc；上游那套 lib/types/** 的 tsc 构建面
  // 在本仓库没有对应物（命名与构建分工见 docs/plugin-naming.md）。
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    // 浏览器半部不该看见 Node 全局：仓库根 node_modules 里 hoist 了 @types/node，
    // 不排除的话全局 setTimeout 取到 Node 的 Timeout，与 window.setTimeout 的
    // number 对不上（MessageIconActions.tsx 的 copyTimer）。
    "types": [],

    // 仓库根 node_modules 里有一批指向 DSH 安装目录的软链接包，它们内部的 import 会
    // 解析到安装目录下的同名副本。于是 session-projection 在程序里出现两份物理文件，
    // dsh-agent 的 declare module 合并可能落到另一份上，useProjection('inbox') 就报
    // 键不存在。这里把该模块钉死在本仓库这一份，保证声明合并只落一个地方。
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-session-projection/types": [
        "../node_modules/@deepseek-ai/dsh-session-projection/lib/types/types.d.ts"
      ]
    }
  },
  // tests/ 暂未纳入：它们引用上游 monorepo 的源码路径（../../ui-conversation/src/...、
  // @deepseek-ai/dsh-client-locale/src/locales/zh.ts 等），独立仓库里没有对应文件，
  // 要移植测试后才能一起类型检查。
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
