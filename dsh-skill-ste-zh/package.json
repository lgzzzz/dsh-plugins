{
  "name": "dsh-skill-ste-zh",
  "version": "1.0.0",
  "description": "把「受控中文技术写作」技能（上游 lemonhall/asd-ste100-skill-zh）作为插件自带资产注册进技能注册表（source 为 bundled，rank 取 BUNDLED_SKILL_RANK）：装上插件即获得 ste-zh 技能与随附的 references / examples / linter，不再需要往 .agents/skills/ 放 SKILL.md。",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.mjs",
    "check": "node --check index.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-alpha.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
