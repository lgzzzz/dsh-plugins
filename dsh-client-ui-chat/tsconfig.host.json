{
  // 宿主半部（index.ts + 共享的 src/chat-settings.ts）的类型检查面。
  // 这一份必须保持「可擦除语法 + 显式 import type」：宿主入口由 Node Type Stripping 直接加载，
  // 没有编译步骤可依赖。浏览器半部由 tsconfig.json 检查。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true
  },
  "files": ["index.ts", "src/chat-settings.ts"],
  // include 与 files 是相加关系；继承来的浏览器 include 必须清空，否则这里会连带检查 src/client/**。
  "include": []
}
