{
  // Minimal tsconfig for tsdown. The upstream monorepo base files and the 40+
  // project references do not exist in dsh-plugins, so this is a self-contained
  // config that only tells the bundler what it needs: JSX through the automatic
  // runtime, and bundler-style module resolution. tsdown bundles src/ straight
  // into lib/, so no tsc pass is involved and no .d.ts is emitted: the upstream
  // tsc build face (lib/types/**) has no counterpart in this standalone repo.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
