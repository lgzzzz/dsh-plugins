{
  // 浏览器半部（src/**）的类型检查面。esbuild 在构建期剥离类型，因此这里**不开**
  // erasableSyntaxOnly：上游源码用了构造函数参数属性（非可擦除语法），浏览器侧合法。
  // 宿主半部单独由 tsconfig.host.json 检查（那里必须可擦除）。
  //
  // 编译器选项沿用上游 packages/client/tsconfig.base*.json 的严格档——上游源码即按它编写。
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],

    "jsx": "react-jsx",

    "noEmit": true,

    // 相对 import 携带显式 .ts 扩展名（esbuild 支持）
    "allowImportingTsExtensions": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 浏览器面只认 DOM 的定时器/全局类型。不关这条时若 @types/node 在解析路径上，
    // window.setTimeout 会被判成 NodeJS.Timeout（上游同一处用 number）。
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "lib"]
}
