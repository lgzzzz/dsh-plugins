{
  "name": "dsh-stats-ttft",
  "version": "1.0.0",
  "private": true,
  "description": "在输入框下方的「性能」统计按钮上显示最近 7 步的平均首 token 时长（TTFT）与输出速度（TPS），点开的气泡正文仍按全会话统计：宿主注册 recentStepStats 会话投影，逐步折叠 TTFT/解码累计；浏览器半部按 id 遮蔽 conversation.composer.dock 的 activity 条目，改写 stats.counts 与 message.tokensPerSecond 的译文，再把气泡里的标题值与速度行还原成全会话读数；投影缺席时用已加载窗口的最后 7 个 assistant 节点兜底。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "check": "node --check lib/client.js && node --check index.ts",
    "test": "node test/run-all.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.3",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
