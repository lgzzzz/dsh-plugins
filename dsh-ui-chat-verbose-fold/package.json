{
  "name": "dsh-ui-chat-verbose-fold",
  "version": "1.0.0",
  "private": true,
  "description": "本地 Web UI 运行时补丁:让 ui-chat 的 verbose 工作详情模式折叠已完成的 Turn。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.mjs",
    "check": "node --check lib/client.js && node --check index.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
