{
  "name": "dsh-ui-chat-verbose-fold",
  "version": "1.3.0",
  "private": true,
  "description": "本地 Web UI 运行时补丁:让 ui-chat 的「完全展开」工作步骤模式遵守「工作步骤收起时机」，并在收起过程行时保持阅读位置；没有可见锚点时回退到最后一条用户消息。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.mjs",
    "test:browser": "node test/browser/run.mjs",
    "check": "node --check lib/client.js && node --check index.ts",
    "check:css": "node check-css.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
