{
  "name": "dsh-focus-free-shortcuts",
  "version": "1.0.0",
  "private": true,
  "description": "在未先点击目标区域时也能触发右侧边栏 pane 命令、关闭当前页面（Web 上 page.close）、双击 Esc 停止回合、审批面板与提问卡片的 Enter/Esc 决策，以及 ⌘⌥J（macOS）/Ctrl+Alt+J（Windows/Linux）聚焦输入框、⌘⌥←/→（macOS）/Ctrl+Alt+←/→（Windows/Linux）切换右侧边栏页面和 ⌘↑/↓（macOS）/Ctrl+↑/↓（Windows/Linux）在前三个工作区显示出来的会话行之间导航、⌘⌥↑/↓（macOS）/Ctrl+Alt+↑/↓（Windows/Linux）只在活跃会话之间切换（行上有状态点者）的快捷键。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && node check-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.mjs",
    "check:css": "node check-css.mjs",
    "check": "node --check lib/client.js && node --check index.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-approval": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-user-questions": "^0.2.0-rc.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
