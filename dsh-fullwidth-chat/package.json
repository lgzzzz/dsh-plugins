{
  "name": "dsh-fullwidth-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Local persistent UI patch: tile the conversation/message column across the whole center column of the Web GUI.",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
