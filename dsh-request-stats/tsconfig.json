{
  // 仅类型检查(pnpm typecheck),不产出文件:宿主半部与浏览器半部都由 tsdown
  // 打包到 lib/;测试与 check.mjs 直接 import src/ 下的 .ts(Node Type Stripping)。
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext", "dom", "dom.iterable"],

    "noEmit": true,

    // 相对 import 带显式 .ts 扩展名(Node Type Stripping 与 tsdown 均支持)
    "allowImportingTsExtensions": true,

    // 仅可擦除语法 + 显式 import type,与 Node Type Stripping 一致
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 宿主半部用到 node: 内建模块;浏览器半部的 DOM 全局来自 lib.dom
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "test"]
}
