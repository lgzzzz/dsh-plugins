{
  // 本仓库(独立插件仓库)没有上游 monorepo 的 tsconfig.base.client.json 与那 14 条
  // project references，所以这里是一份自足配置：只告诉打包器它需要的事——走自动
  // JSX 运行时、按打包器规则解析模块。tsdown 直接从 src/ 打 lib/，不经过 tsc；
  // 上游那套 lib/types/** 的 tsc 构建面在本仓库没有对应物。
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "lib"]
}
