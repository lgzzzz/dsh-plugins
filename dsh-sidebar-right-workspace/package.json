{
  "name": "dsh-client-ui-sidebar-right-lgz",
  "description": "This is a fork of @deepseek-ai/dsh-client-ui-sidebar-right in deepseek harness. Right Sidebar: the docking surface's session-bound state, its panel and header expand control, and the navigation service over it",
  "version": "0.2.1-alpha.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-brand": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-resources": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-dockkit": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-util-crypto": "^0.2.1-alpha.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "picomatch": "^4.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  }
}
