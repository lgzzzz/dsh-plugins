{
  "name": "dsh-workspace-activity-sort",
  "version": "1.0.0",
  "private": true,
  "description": "按会话活动自动排序左侧栏的 Workspace 分组：把最近有用户消息的工作区提到 Workspace 注册表持久显示顺序的最前。",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/run-all.mjs",
    "check": "node --check index.ts && node --check src/bump.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
