{
  "name": "dsh-workspace-quick-switch",
  "version": "1.0.0",
  "private": true,
  "description": "快捷键 ⌘⌥M / Ctrl+Alt+M 弹出工作区浮层(按左侧栏 Workspace 顺序,Enter 在该工作区新建会话),⌘⌥I / Ctrl+Alt+I 弹出会话浮层(按左侧栏「单列表 + 最近更新 + 隐藏已归档」的顺序,Enter 打开该会话);两张浮层都是一屏 10 个、←/→ 翻页、↑/↓ 选行,焦点在终端(.xterm)里时同样生效(window 捕获阶段拦下,macOS 的 ⌘⌥I 死键另有补偿)。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "test": "node test/run-all.mjs",
    "check": "node --check lib/client.js && node --check index.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
