{
  "name": "dsh-workspace-quick-switch",
  "version": "1.0.0",
  "private": true,
  "description": "快捷键 ⌘⌥M(macOS)/Ctrl+Alt+M(Windows/Linux) 弹出浮层,按左侧栏当前的工作区顺序列出工作区(一屏 10 个,←/→ 翻页),↑/↓ 导航、Enter 在该工作区新建会话;焦点在终端(.xterm)里时同样生效(window 捕获阶段拦下)。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "test": "node test/run-all.mjs",
    "check": "node --check lib/client.js && node --check index.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
