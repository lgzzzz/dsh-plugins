{
  "name": "dsh-changes-behavior",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "description": "右栏改动视图的统一行为：打开指定入口（改动卡片标题、⌘⌥Y、会话面板那行「本地变更」）时默认全屏，其余打开一律非全屏；改动审查标签页按面板呈现方式默认分栏并默认换行；关掉改动卡片的悬停浮层；「本地变更」「变更请求」字号统一为 14px，文件列表宽度固定为上游默认值（隐藏拖动把手，宽度不再可调）；宿主启动时给上游客户端产物打一行补丁，让单文件改动卡片也按「已编辑 1 个文件 + 文件行」的汇总形制渲染。",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:css": "node check-css.mjs",
    "check": "node --check lib/client.js && node --check index.ts",
    "test": "node test/run-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.3-alpha.2",
    "dsh-shortcut-utils": "workspace:*",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3"
  }
}
